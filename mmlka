        Notify("👁️ Player ESP", (Value and "مفعل" or "معطل"), 2)
        if Value then
            task.spawn(function()
                while _G.PlayerESPEnabled do
                    pcall(function()
                        for _, p in pairs(Players:GetPlayers()) do
                            if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                                local rootPart = p.Character.HumanoidRootPart
                                local head = p.Character:FindFirstChild("Head")
                                if rootPart and head then
                                    if not rootPart:FindFirstChild("PlayerESPBox") then
                                        local box = Instance.new("BoxHandleAdornment")
                                        box.Name = "PlayerESPBox"
                                        box.Adornee = rootPart
                                        box.Size = Vector3.new(2, 6, 1)
                                        box.Color3 = Color3.fromRGB(255, 0, 0)
                                        box.Transparency = 0.5
                                        box.AlwaysOnTop = true
                                        box.ZIndex = 10
                                        box.Parent = Workspace.CurrentCamera
                                    end
                                    if not head:FindFirstChild("PlayerESPNameTag") then
                                        local nameTag = Instance.new("BillboardGui")
                                        nameTag.Name = "PlayerESPNameTag"
                                        nameTag.Adornee = head
                                        nameTag.Size = UDim2.new(0, 100, 0, 20)
                                        nameTag.AlwaysOnTop = true
                                        nameTag.ExtentsOffset = Vector3.new(0, 2, 0)
                                        nameTag.Parent = Workspace.CurrentCamera
                                        local textLabel = Instance.new("TextLabel", nameTag)
                                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                                        textLabel.BackgroundTransparency = 1
                                        textLabel.Text = p.Name
                                        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                                        textLabel.TextSize = 14
                                        textLabel.Font = Enum.Font.SourceSansBold
                                    end
                                end
                            else
                                -- Cleanup if player leaves or character removed
                                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character.HumanoidRootPart:FindFirstChild("PlayerESPBox") then
                                    p.Character.HumanoidRootPart.PlayerESPBox:Destroy()
                                end
                                if p.Character and p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("PlayerESPNameTag") then
                                    p.Character.Head.PlayerESPNameTag:Destroy()
                                end
                            end
                        end
                    end)
                    task.wait(0.5)
                end
                -- Final cleanup when ESP is disabled
                for _, p in pairs(Players:GetPlayers()) do
                    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character.HumanoidRootPart:FindFirstChild("PlayerESPBox") then
                        p.Character.HumanoidRootPart.PlayerESPBox:Destroy()
                    end
                    if p.Character and p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("PlayerESPNameTag") then
                        p.Character.Head.PlayerESPNameTag:Destroy()
                    end
                end
            end)
        else
            -- Cleanup when ESP is disabled
            for _, p in pairs(Players:GetPlayers()) do
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character.HumanoidRootPart:FindFirstChild("PlayerESPBox") then
                    p.Character.HumanoidRootPart.PlayerESPBox:Destroy()
                end
                if p.Character and p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("PlayerESPNameTag") then
                    p.Character.Head.PlayerESPNameTag:Destroy()
                end
            end
        end
    end
})

