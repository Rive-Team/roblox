local function UpdateAvatar()
    pcall(function()
        local char = Player.Character
        if char then
            -- حذف القديم
            for _, child in pairs(AvatarViewport:GetChildren()) do
                if child:IsA("Model") then child:Destroy() end
            end
            
            -- نسخ الشخصية
            local clone = char:Clone()
            clone:BreakJoints()
            
            -- إزالة Humanoid وإضافة AnimationController
            local hum = clone:FindFirstChildOfClass("Humanoid")
            if hum then hum:Destroy() end
            
            local animController = Instance.new("AnimationController")
            animController.Parent = clone
            
            clone.Parent = AvatarViewport
            
            -- تعديل الكاميرا
            local camera = Instance.new("Camera")
            camera.Parent = AvatarViewport
            AvatarViewport.CurrentCamera = camera
            
            local head = clone:FindFirstChild("Head")
            if head then
                camera.CFrame = CFrame.new(head.Position + Vector3.new(0, 0, 3.5), head.Position)
            end
        end
    end)
end

