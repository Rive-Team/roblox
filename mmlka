-- ═════════════════════ 👁️ ESP Tab (NEW) ═════════════════════
ESPTab:CreateSection("👁️ ESP اللاعبين")

local PlayerESPEnabled = false
local PlayerESPHolders = {}

local function UpdatePlayerESP()
    for _, v in pairs(PlayerESPHolders) do
        v:Destroy()
    end
    PlayerESPHolders = {}

    if not PlayerESPEnabled then return end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local rootPart = p.Character.HumanoidRootPart
            local head = p.Character:FindFirstChild("Head")
            if rootPart and head then
                local box = Instance.new("BoxHandleAdornment")
                box.Adornee = rootPart
                box.Size = Vector3.new(2, 6, 1) -- تقريبي لحجم اللاعب
                box.Color3 = Color3.fromRGB(255, 0, 0)
                box.Transparency = 0.5
                box.AlwaysOnTop = true
                box.ZIndex = 10
                box.Parent = Workspace.CurrentCamera
                table.insert(PlayerESPHolders, box)

                local nameTag = Instance.new("BillboardGui")
                nameTag.Adornee = head
                nameTag.Size = UDim2.new(0, 100, 0, 20)
                nameTag.AlwaysOnTop = true
                nameTag.ExtentsOffset = Vector3.new(0, 2, 0)
                nameTag.Parent = Workspace.CurrentCamera

                local textLabel = Instance.new("TextLabel")
                textLabel.Size = UDim2.new(1, 0, 1, 0)
                textLabel.BackgroundTransparency = 1
                textLabel.Text = p.Name
                textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                textLabel.TextSize = 14
                textLabel.Font = Enum.Font.SourceSansBold
                textLabel.Parent = nameTag
                table.insert(PlayerESPHolders, nameTag)
            end
        end
    end
end

ESPTab:CreateToggle({
    Name = "👁️ تفعيل ESP اللاعبين",
    CurrentValue = false,
    Callback = function(Value)
        PlayerESPEnabled = Value
        if Value then
            Notify("👁️ ESP", "تم تفعيل ESP اللاعبين!", 2)
            UpdatePlayerESP()
        else
            Notify("🛑 توقف", "تم إيقاف ESP اللاعبين", 2)
            for _, v in pairs(PlayerESPHolders) do
                v:Destroy()
            end
            PlayerESPHolders = {}
        end
    end
})

Players.PlayerAdded:Connect(UpdatePlayerESP)
Players.PlayerRemoving:Connect(UpdatePlayerESP)

