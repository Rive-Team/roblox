        Label.TextColor3 = Color3.fromRGB(220, 220, 240)
        Label.TextSize = 14
        Label.Font = Enum.Font.Gotham
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = Frame
        
        local ValueBox = Instance.new("Frame")
        ValueBox.Size = UDim2.new(0, 50, 0, 22)
        ValueBox.Position = UDim2.new(1, -65, 0, 8)
        ValueBox.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
        ValueBox.BorderSizePixel = 0
        ValueBox.Parent = Frame
        
        Instance.new("UICorner", ValueBox).CornerRadius = UDim.new(0, 6)
        
        local ValueText = Instance.new("TextLabel")
        ValueText.Size = UDim2.new(1, 0, 1, 0)
        ValueText.BackgroundTransparency = 1
        ValueText.Text = tostring(config.CurrentValue)
        ValueText.TextColor3 = Color3.fromRGB(255, 215, 0)
        ValueText.TextSize = 12
        ValueText.Font = Enum.Font.GothamBold
        ValueText.Parent = ValueBox
        
        local Track = Instance.new("Frame")
        Track.Size = UDim2.new(1, -30, 0, 8)
        Track.Position = UDim2.new(0, 15, 0, 42)
        Track.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
        Track.BorderSizePixel = 0
        Track.Parent = Frame
        
        Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)
        
        local Fill = Instance.new("Frame")
        Fill.Size = UDim2.new((config.CurrentValue - config.Range[1]) / (config.Range[2] - config.Range[1]), 0, 1, 0)
        Fill.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
        Fill.BorderSizePixel = 0
        Fill.Parent = Track
        
        Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)
        
        local Thumb = Instance.new("Frame")
        Thumb.Size = UDim2.new(0, 16, 0, 16)
        Thumb.Position = UDim2.new((config.CurrentValue - config.Range[1]) / (config.Range[2] - config.Range[1]), -8, 0.5, -8)
        Thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Thumb.BorderSizePixel = 0
        Thumb.Parent = Track
        
        Instance.new("UICorner", Thumb).CornerRadius = UDim.new(1, 0)
        
        local ThumbStroke = Instance.new("UIStroke", Thumb)
        ThumbStroke.Color = Color3.fromRGB(255, 215, 0)
        ThumbStroke.Thickness = 2
        
        local Dragging = false
        
        local function UpdateSlider(input)
            local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
            local value = config.Range[1] + (pos * (config.Range[2] - config.Range[1]))
            value = math.floor(value / config.Increment) * config.Increment
            
            Fill.Size = UDim2.new(pos, 0, 1, 0)
            Thumb.Position = UDim2.new(pos, -8, 0.5, -8)
            Label.Text = config.Name .. ": " .. value .. (config.Suffix or "")
            ValueText.Text = tostring(value)
            
            if config.Callback then config.Callback(value) end
            return value
        end
        
        Track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                Dragging = true
                UpdateSlider(input)
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                UpdateSlider(input)
            end
        end)
        
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
