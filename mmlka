-- Metatable Hooking for Humanoid properties (WalkSpeed, JumpPower)
-- This makes it so when the game's anti-cheat tries to read these properties,
-- it gets the default (legitimate) value, even if our script changed them.
local old_namecall = getnamecallmethod()
local old_index = getmetatable(Humanoid).__index
local old_newindex = getmetatable(Humanoid).__newindex

local spoofed_walkspeed = 16
local spoofed_jumppower = 50

setmetatable(Humanoid, {
    __index = function(self, key)
        if key == "WalkSpeed" and _G.WalkSpeedEnabled then
            return spoofed_walkspeed
        elseif key == "JumpPower" and _G.JumpPowerEnabled then
            return spoofed_jumppower
        else
            return old_index(self, key)
        end
    end,
    __newindex = function(self, key, value)
        if key == "WalkSpeed" and _G.WalkSpeedEnabled then
            -- Allow our script to set it, but anti-cheat reads spoofed value
            rawset(self, key, value)
        elseif key == "JumpPower" and _G.JumpPowerEnabled then
            rawset(self, key, value)
        else
            old_newindex(self, key, value)
        end
    end
})

-- Anti-Kick Hooking
-- This attempts to prevent the client from being kicked by hooking the Kick function.
-- Note: Server-sided kicks are still possible.
local old_kick = Player.Kick
Player.Kick = function(message)
    if _G.AntiKickEnabled then
        warn("Anti-Kick prevented a kick with message: " .. message)
        return
    else
        return old_kick(Player, message)
    end
end

-- Remote Event Hooking (Partial - for Anti-Fine)
-- This is a more advanced technique to intercept remote events.
-- For Anti-Fine, we want to prevent the client from sending fine notifications.
-- This is highly game-specific and requires knowing the exact RemoteEvent names.
-- As a general approach, we can try to hook all FireServer calls.

local old_fireserver = nil

pcall(function()
    local fireServer_mt = getrawmetatable(game.ReplicatedStorage.RemoteEvent)
    local old_fireServer = fireServer_mt.FireServer

    fireServer_mt.FireServer = newcclosure(function(self, ...)
        local args = {...}
        if _G.AntiFineEnabled then
            -- Attempt to filter out fine-related remote events
            -- This is a placeholder and needs specific event names for Kingdom World
            if tostring(self.Name):lower():find("fine") or tostring(self.Name):lower():find("violation") then
                warn("Anti-Fine: Blocked remote event: " .. self.Name)
                return
            end
            for i, v in ipairs(args) do
                if type(v) == "string" and (v:lower():find("fine") or v:lower():find("violation")) then
                    warn("Anti-Fine: Blocked remote event with fine-related argument: " .. self.Name)
                    return
                end
            end
        end
        return old_fireServer(self, unpack(args))
    end)
end)


